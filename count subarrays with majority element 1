class Fenwick:
    def __init__(self, n):
        self.bit = [0] * (n + 1)

    def update(self, i, val):
        while i < len(self.bit):
            self.bit[i] += val
            i += i & -i

    def query(self, i):
        res = 0
        while i > 0:
            res += self.bit[i]
            i -= i & -i
        return res


class Solution:
    def countSubarrays(self, nums: List[int], target: int) -> int:
        prefix = [0]

        for x in nums:
            prefix.append(
                prefix[-1] + (1 if x == target else -1)
            )

        vals = sorted(set(prefix))

        bit = Fenwick(len(vals))
        ans = 0

        for p in prefix:
            pos = bisect_left(vals, p) + 1

            ans += bit.query(pos - 1)

            bit.update(pos, 1)

        return ans
