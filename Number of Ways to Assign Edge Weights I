class Solution:
    def assignEdgeWeights(self, edges: List[List[int]]) -> int:
        MOD = 10**9 + 7
        n = len(edges) + 1

        g = [[] for _ in range(n + 1)]
        for u, v in edges:
            g[u].append(v)
            g[v].append(u)

        q = deque([(1, 0)])  # node, depth
        seen = {1}
        max_depth = 0

        while q:
            u, depth = q.popleft()
            max_depth = max(max_depth, depth)

            for v in g[u]:
                if v not in seen:
                    seen.add(v)
                    q.append((v, depth + 1))

        return pow(2, max_depth - 1, MOD)
