class Solution:
    def processStr(self, s: str, k: int) -> str:
        length = 0
        for c in s:
            if c in "abcdefghijklmnopqrstuvwxyz":
                length += 1 
            elif c == '*':
                length = max(0,length-1)
            elif c == '#':
                length *= 2
        if k >= length:
            return '.'
        for c in reversed(s):
            if c == '#':
                half = length // 2
                if k >= half:
                    k -= half
                length = half
            elif c == '%':
                k = length - 1 -k
            elif c == '*':
                length += 1
            else:
                if k == length - 1:
                    return c
                length -= 1
        return '.'
