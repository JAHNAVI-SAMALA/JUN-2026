class Solution:
    def zigZagArrays(self, n: int, l: int, r: int) -> int:
        MOD = 10**9 + 7
        m = r - l + 1

        dpUp = [i for i in range(m)]
        dpDown = [m - 1 - i for i in range(m)]

        for _ in range(3, n + 1):
            pref = [0] * m
            pref[0] = dpDown[0]

            for i in range(1, m):
                pref[i] = (pref[i - 1] + dpDown[i]) % MOD

            suff = [0] * m
            suff[m - 1] = dpUp[m - 1]

            for i in range(m - 2, -1, -1):
                suff[i] = (suff[i + 1] + dpUp[i]) % MOD

            newUp = [0] * m
            newDown = [0] * m

            for i in range(m):
                if i > 0:
                    newUp[i] = pref[i - 1]
                if i < m - 1:
                    newDown[i] = suff[i + 1]

            dpUp = newUp
            dpDown = newDown

        return (sum(dpUp) + sum(dpDown)) % MOD
