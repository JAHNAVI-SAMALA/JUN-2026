class Solution:
    def processStr(self, s: str) -> str:
        result = ""
        for c in s:
            if c in "abcdefghijklmnopqrstuvwxyz":
                result += c
            elif c == '*':
                result = result[:-1]
            elif c == '#':
                result = result + result
            elif c == '%':
                result = result[::-1]
        return result
