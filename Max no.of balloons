class Solution:
    def maxNumberOfBalloons(self, text: str) -> int:
        freq = {}
        for c in text:
            if c in freq:
                freq[c] += 1
            else:
                freq[c] = 1
        return min(freq.get('b',0),
        freq.get('a',0),
        freq.get('l',0)//2,
        freq.get('o',0)//2,
        freq.get('n',0))
